# Copy to .env.local for local development. In Vercel, set the same variables
# under Project → Settings → Environment Variables. Never commit real values.

# Public URL of the site, no trailing slash (used for share links and auth redirects).
SITE_URL=http://localhost:3000

# Day #1 of the game (YYYY-MM-DD, Cotonou time). Never change it after launch:
# day numbers and /j/<n> links depend on it.
LAUNCH_DATE=2026-11-02

# Supabase → Project Settings → API Keys. These are only used on the server
# (the browser never talks to Supabase directly), hence no NEXT_PUBLIC_ prefix.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key: server only. Used for the admin pages, the seed script and to
# forward the player's IP to Supabase Auth rate limits.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Comma-separated e-mails allowed on /admin (accounts must be confirmed, not anonymous).
ADMIN_EMAILS=you@example.com

# Cloudflare Turnstile site key (Cloudflare dashboard → Turnstile). The matching
# SECRET key goes in Supabase → Authentication → Attack Protection, not here.
# Leave empty only if CAPTCHA is also disabled in Supabase.
# Test key that always passes: 1x00000000000000000000AA
TURNSTILE_SITE_KEY=

# Microsoft Clarity project ID (clarity.microsoft.com → Settings → Overview). Optional.
CLARITY_PROJECT_ID=
